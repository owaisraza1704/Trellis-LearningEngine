  "retrieval_design": {
    "standard_supplied_pool_size": 12,
    "fallback_supplied_pool_size": 11,
    "fixed_web_fallback_cases": 8,
    "gold_unit": "source passage",
    "passage_character_limit_exclusive": 1600,
    "empty_gold_cases": 24,
    "empty_gold_policy": "Evidence-absent cases have no positive retrieval gold. Retrieval recall and ranking metrics are undefined for those cases and should be excluded rather than assigned 0 or 1.",
    "duplicate_passage_policy": "Each family's fourth reference has an identical web-kind copy for a forced-fallback case. Only one copy is available in an evidence-answerable case. Both copies remain in the same split.",
    "candidate_order": "Candidate IDs in each case are deterministically permuted by SHA-256 of v1:case_id:source_id. The order does not consult gold labels; it is not a relevance ranking."
  },
  "intended_scope": [
    "Small offline reference set for evidence retrieval, answer relevance and completeness, grounding, abstention, source priority, and conversation resolution.",
    "Every family has one elliptical follow-up, one explicit topic switch, one fixed-web-fallback question, and two conflicting-draft questions.",
    "Expected answers describe the factual core and necessary limitations, not exact wording or a model-generated target response.",
    "Source-only unread-document prompts start with the checkbox false so the resolver must preserve the restriction expressed in the question; supplied-policy cases explicitly set it true."
  ],
  "limits": [
    "All cases and labels were authored by AI and remain pending independent human review. No result on this version is a human-validated quality or release claim.",
    "The small, English-only software-education set is not a representative sample of all learning domains or production users.",
    "Fixed short passages omit live search quality, extraction/OCR, long-document chunking, changing pages, authentication, provider availability, and real user interaction.",
    "The topic-family split reduces direct paraphrase leakage but is not a blinded or statistically powered benchmark.",
    "Question/reference authorship may share model-family biases with a generator or judge. Human review and judge calibration are required for stronger conclusions.",
    "URLs identify review targets; source text is a curated paraphrase and may contain errors until checked. Synthetic project names, values, incidents, and policies are not real facts.",
    "Conflict labels require an answered summary that exposes both claims and the absence of authority; choosing a winner is incorrect. Abstention and unverified labels must also be checked for content and citation behavior."
  ]
